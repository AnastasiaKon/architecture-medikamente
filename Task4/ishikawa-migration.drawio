<mxfile host="app.diagrams.net" type="device"><diagram name="Ishikawa" id="ish"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="head" value="Снижение производительности&lt;br&gt;и работоспособности системы&lt;br&gt;при миграции монолита&lt;br&gt;«Медикаменте» на микросервисы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1570" y="505" width="300" height="140" as="geometry"/></mxCell><mxCell id="tail" value="" style="shape=ellipse;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="571" width="8" height="8" as="geometry"/></mxCell><mxCell id="spine" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;strokeWidth=3;" edge="1" parent="1" source="tail" target="head"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="Диаграмма Исикавы: узкие места при миграции «Медикаменте»" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="cat_top_0" value="Инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260.0" y="80" width="260" height="60" as="geometry"/></mxCell><mxCell id="j_top_0" value="" style="shape=ellipse;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="627.0" y="572" width="6" height="6" as="geometry"/></mxCell><mxCell id="b_top_0" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="cat_top_0" target="j_top_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_top_0_0" value="один физический серве