<mxfile host="app.diagrams.net" type="device"><diagram name="P5 Бэк-офис To-Be" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Домен HR/Finance - отдельный сегмент сети, серверы в ЦОД (152-ФЗ), K8s + PostgreSQL" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="560" as="geometry"/></mxCell><mxCell id="t" value="P5. Учёт ТМЦ, кадровый и бухгалтерский учёт - To-Be" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;зелёный - мера защиты на этапе потока; теги данных в квадратных скобках" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="900" height="40" as="geometry"/></mxCell><mxCell id="wh" value="Сотрудник склада" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="140" height="60" as="geometry"/></mxCell><mxCell id="acc" value="Бухгалтер" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="140" height="60" as="geometry"/></mxCell><mxCell id="gov" value="ФНС, СФР, банк" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="140" height="60" as="geometry"/></mxCell><mxCell id="p1" value="5.1 Учёт ТМЦ и закупок&lt;br&gt;1С:Торговля (клиент-сервер)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="p2" value="5.2 Кадровый учёт, зарплата&lt;br&gt;1С:Бухгалтерия (клиент-сервер)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="200" height="80" as="geometry"/></mxCell><mxCell id="p3" value="5.3 Отчётность&lt;br&gt;1С -&amp;gt; ЭДО" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="s14" value="D14 1С:Торговля DB (PostgreSQL, TDE)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="240" height="50" as="geometry"/></mxCell><mxCell id="s12" value="D12 1С:Бухгалтерия DB (PostgreSQL, TDE)&lt;br&gt;[pii:employee, hr] шифр. ИНН/СНИЛС" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="240" height="60" as="geometry"/></mxCell><mxCell id="s16" value="D16 Резервные копии (шифрованные, в РФ)&lt;br&gt;тест восстановления" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="240" height="60" as="geometry"/></mxCell><mxCell id="s4" value="D4 Audit log (SIEM)&lt;br&gt;журнал регистрации 1С" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="580" width="240" height="50" as="geometry"/></mxCell><mxCell id="c1" value="Контроль: обмен между базами 1С по HTTPS-сервисам с аутентификацией вместо OLE; роли 1С по принципу need-to-know" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="270" height="80" as="geometry"/></mxCell><mxCell id="c2" value="Контроль: доступ к зарплатной ведомости - отдельная роль + MFA; маскирование ИНН/СНИЛС в отчётах; журнал регистрации 1С отправляется в SIEM" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="270" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Контроль: AD/DNS/DHCP, файлы, почта и 1С разнесены по разным хостам/VLAN; бэкапы шифруются, ключи в KMS, хранение в РФ, срок по политике" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="460" width="270" height="90" as="geometry"/></mxCell><mxCell id="e0" value="OIDC + MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" e