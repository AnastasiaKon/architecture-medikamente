<mxfile host="app.diagrams.net" type="device"><diagram name="P2 Приём и медкарта To-Be" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Платформа «Медикаменте» - домен Clinical (изолированный сегмент, mTLS)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="660" as="geometry"/></mxCell><mxCell id="t" value="P2. Приём у специалиста и ведение медкарты - To-Be" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;зелёный - мера защиты на этапе потока; теги данных в квадратных скобках" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="900" height="40" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(моб. приложение / ЛК)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="160" height="70" as="geometry"/></mxCell><mxCell id="doc" value="Специалист-медик&lt;br&gt;(Портал сотрудника)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="160" height="70" as="geometry"/></mxCell><mxCell id="p1" value="2.1 Открытие карты&lt;br&gt;Сервис Медкарта (ABAC: врач + активная запись)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="220" height="80" as="geometry"/></mxCell><mxCell id="p2" value="2.2 Ведение приёма&lt;br&gt;Сервис Медкарта (структурированные поля)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="220" height="80" as="geometry"/></mxCell><mxCell id="p3" value="2.3 Заключение и назначения&lt;br&gt;Сервис Медкарта -&amp;gt; Документы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="220" height="80" as="geometry"/></mxCell><mxCell id="s2" value="D6 Clinical DB&lt;br&gt;[pii:special, medical] шифрование полей AES-GCM, ключи в KMS, TDE" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="320" width="240" height="70" as="geometry"/></mxCell><mxCell id="s7" value="D7 Clinical Documents (S3, SSE-KMS)&lt;br&gt;заключения PDF [medical]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="240" height="60" as="geometry"/></mxCell><mxCell id="s4" value="D4 Audit log (WORM, SIEM)&lt;br&gt;кто, когда, чью карту, какие поля" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="240" height="60" as="geometry"/></mxCell><mxCell id="p4" value="2.4 Личный кабинет&lt;br&gt;owner-check по sub токена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="220" height="60" as="geometry"/></mxCell><mxCell id="s1" value="D1 Patient Identity DB&lt;br&gt;связь patient_id &amp;lt;-&amp;gt; Ф. И. О. только через API" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="240" height="60" as="geometry"/></mxCell><mxCell id="c1" value="Контроль: ABAC - доступ к карте только при наличии записи/назначения на этого врача; «break-glass» с обязательным обоснованием и алертом" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="270" height="90" as="geometry"/></mxCell><mxCell id="c2" value="Контроль: карта хранится под patient_id, Ф. И. О. подтягивается из Identity отдельным вызовом; поля с тегом medical шифруются на уровне приложения; VDI/запрет локального сохранения и USB" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="270" height="110" as="geometry"/></mxCell><mxCell id="c3" value="Контроль: заключение выдаётся пациенту только через ЛК/приложение (своё, по OIDC-сессии), не по почте; ссылка одноразовая с TTL" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="270" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Контроль: UEBA/алерты - массовое чтение карт, доступ ночью, чтение карт без записи" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="610" width="270" height="70" as="geometry"/></mxCell><mxCell id="e0" value="OIDC + MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="doc" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="карта по patient_id (ABAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Ф. И. О. по patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="карта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="жалобы, анамнез (на приёме)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="pat" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="[pii:special, medical]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="диагноз, назначения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="PDF [medical]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p3" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="по patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="s7" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="своё заключение, HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p4" target="pat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>