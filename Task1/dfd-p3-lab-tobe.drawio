<mxfile host="app.diagrams.net" type="device"><diagram name="P3 Анализы To-Be" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Платформа «Медикаменте» - домен Clinical + Integration" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="640" as="geometry"/></mxCell><mxCell id="t" value="P3. Анализы: интеграция с лабораторией по API - To-Be" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;зелёный - мера защиты на этапе потока; теги данных в квадратных скобках" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="900" height="40" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(ЛК / приложение)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="160" height="70" as="geometry"/></mxCell><mxCell id="lab" value="Лаборатория&lt;br&gt;(партнёрский API)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="160" height="70" as="geometry"/></mxCell><mxCell id="p1" value="3.1 Направление&lt;br&gt;Сервис Медкарта" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="p2" value="3.2 Заказ в лабораторию&lt;br&gt;Сервис Lab Integration (адаптер)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="200" height="80" as="geometry"/></mxCell><mxCell id="p3" value="3.3 Приём результатов&lt;br&gt;Сервис Lab Integration -&amp;gt; Медкарта" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="200" height="80" as="geometry"/></mxCell><mxCell id="s9" value="D9 Lab Orders DB&lt;br&gt;order_id, lab_pseudonym, статус; без Ф. И. О." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="320" width="240" height="60" as="geometry"/></mxCell><mxCell id="s2" value="D6 Clinical DB&lt;br&gt;результаты [pii:special, medical], шифр. полей" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="240" height="60" as="geometry"/></mxCell><mxCell id="s4" value="D4 Audit log (WORM, SIEM)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="240" height="50" as="geometry"/></mxCell><mxCell id="c1" value="Контроль: контракт с лабораторией = поручение на обработку ПДн; в заказ уходит lab_pseudonym (токен), пол и год рождения - без Ф. И. О. и диагноза (Data Minimization)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="270" height="100" as="geometry"/></mxCell><mxCell id="c2" value="Контроль: mTLS + OAuth2 client credentials, подпись ответов, allowlist IP; API-контракт с тегами x-data-tags проверяется линтером в CI - поля [pii:special] в партнёрский API запрещены" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="270" height="110" as="geometry"/></mxCell><mxCell id="c3" value="Контроль: результат пишется в карту под patient_id; пациент видит только свои результаты (owner-check по sub токена); почта и бумажный реестр исключены" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="460" width="270" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Контроль: нетипичные вызовы API (перебор order_id, объём) - алерт в SIEM; rate limit на шлюзе" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="270" height="70" as="geometry"/></mxCell><mxCell id="p4" value="3.4 Выдача результатов&lt;br&gt;ЛК / приложение (owner-check)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="200" height="60" as="geometry"/></mxCell><mxCell id="e0" value="на приёме" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="направление по patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="order_id, lab_pseudonym" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="POST /orders {lab_pseudonym, тесты} mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="lab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="webhook /results {order_id} подписан" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="lab" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="статус" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p3" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value