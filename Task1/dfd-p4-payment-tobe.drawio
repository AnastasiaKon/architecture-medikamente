<mxfile host="app.diagrams.net" type="device"><diagram name="P4 Оплата To-Be" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Платформа «Медикаменте» - домен Billing (отдельный сегмент, PCI-scope минимизирован)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="580" as="geometry"/></mxCell><mxCell id="t" value="P4. Оплата услуг через платёжный шлюз - To-Be" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;зелёный - мера защиты на этапе потока; теги данных в квадратных скобках" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="900" height="40" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(ЛК / касса)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="160" height="70" as="geometry"/></mxCell><mxCell id="psp" value="Платёжный провайдер&lt;br&gt;(PCI DSS)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="160" height="70" as="geometry"/></mxCell><mxCell id="p1" value="4.1 Выставление счёта&lt;br&gt;Сервис Billing" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="200" height="80" as="geometry"/></mxCell><mxCell id="p2" value="4.2 Оплата&lt;br&gt;Платёжный шлюз (адаптер PSP + ККМ)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="200" height="80" as="geometry"/></mxCell><mxCell id="p3" value="4.3 Учёт и выгрузка в 1С&lt;br&gt;Сервис Billing -&amp;gt; 1С (клиент-сервер)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="s13" value="D13 Billing DB&lt;br&gt;счёт, patient_id, сумма, токен платежа [financial]; PAN не хранится" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="250" height="70" as="geometry"/></mxCell><mxCell id="s10" value="D10 ККМ (ОФД)&lt;br&gt;фискальные документы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="250" height="50" as="geometry"/></mxCell><mxCell id="s12" value="D12 1С:Бухгалтерия (PostgreSQL, TDE)&lt;br&gt;роли, журнал регистрации" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="510" width="250" height="60" as="geometry"/></mxCell><mxCell id="s4" valu