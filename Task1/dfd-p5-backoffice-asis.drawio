<mxfile host="app.diagrams.net" type="device"><diagram name="P5 Бэк-офис As-Is" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Физический сервер Windows Server 2022 в офисе: AD, DNS, DHCP, файлы, Exchange, 1С" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="540" as="geometry"/></mxCell><mxCell id="t" value="P5. Учёт ТМЦ, кадровый и бухгалтерский учёт - As-Is" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;красный - проблемная зона / незащищённый поток" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="900" height="40" as="geometry"/></mxCell><mxCell id="wh" value="Сотрудник склада" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="140" height="60" as="geometry"/></mxCell><mxCell id="acc" value="Бухгалтер" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="140" height="60" as="geometry"/></mxCell><mxCell id="gov" value="ФНС, СФР, банк" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillCo