<mxfile host="app.diagrams.net" type="device"><diagram name="P1 Регистрация и запись To-Be" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Платформа «Медикаменте» (K8s, ЦОД в РФ); доступ только через API Gateway + IdP" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="1130" height="700" as="geometry"/></mxCell><mxCell id="t" value="P1. Запись пациента на приём и регистрация - To-Be" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lg" value="Легенда: сиреневый - внешняя сущность, синий - процесс, оранжевый - хранилище,&lt;br&gt;зелёный - мера защиты на этапе потока; теги данных в квадратных скобках" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="900" height="40" as="geometry"/></mxCell><mxCell id="pat" value="Пациент&lt;br&gt;(портал / моб. приложение)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="160" height="70" as="geometry"/></mxCell><mxCell id="p1" value="1.1 Самозапись / приём обращения&lt;br&gt;Портал клиента, Портал ресепшена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="210" height="80" as="geometry"/></mxCell><mxCell id="p2" value="1.2 Регистрация пациента&lt;br&gt;Сервис Identity (согласие, минимальная анкета)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="210" height="80" as="geometry"/></mxCell><mxCell id="p3" value="1.3 Запись к специалисту&lt;br&gt;Сервис Расписание" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="p4" value="1.4 Уведомления&lt;br&gt;Сервис Нотификаций (push/SMS/робот)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=1;arcSize=20;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="210" height="80" as="geometry"/></mxCell><mxCell id="s1" value="D1 Patient Identity DB&lt;br&gt;[pii:direct, pii:contact] шифр. полей, TDE" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="230" height="60" as="geometry"/></mxCell><mxCell id="s2" value="D2 Documents (S3, SSE-KMS)&lt;br&gt;договор, паспорт [pii:direct, legal]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="390" width="230" height="60" as="geometry"/></mxCell><mxCell id="s3" value="D3 Schedule DB&lt;br&gt;запись = patient_id (псевдоним) + слот" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="230" height="60" as="geometry"/></mxCell><mxCell id="s4" value="D4 Audit log (WORM, SIEM)&lt;br&gt;[audit] только псевдонимы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=partialRectangle;top=1;bottom=1;left=1;right=0;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="660" width="230" height="60" as="geometry"/></mxCell><mxCell id="doc" value="Специалист-медик&lt;br&gt;(Портал сотрудника)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="480" width="160" height="70" as="geometry"/></mxCell><mxCell id="c1" value="Контроль: TLS 1.2+, MFA, rate limit, капча; согласие на обработку ПДн фиксируется с версией и датой; собираются только обязательные поля" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="270" height="90" as="geometry"/></mxCell><mxCell id="c2" value="Контроль: RBAC «ресепшен» - контакты и расписание, без медкарты; ABAC «врач» - записи только к себе; каждое чтение [pii:*] пишется в аудит" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="270" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Контроль: единый patient_id, Data Lineage в каталоге - запрос на удаление/прекращение обработки выполняется по всем копиям; срок хранения по политике" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="270" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Контроль: в уведомлениях только И. О. и время, без диагноза; маскирование телефона в UI и логах; DLP на почте" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;shape=note;size=12;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="270" height="80" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS, OIDC-вход" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="минимальная анкета + согласие" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="[pii:direct, pii:contact]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="скан договора [legal]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="patient_id (псевдоним)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#333333;" edge="1" parent="1" source="p2" t