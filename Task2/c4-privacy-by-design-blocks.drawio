<mxfile host="app.diagrams.net" type="device"><diagram name="Блоки Privacy by Design и аналитический слой" id="Блоки-Privacy-by-Design-и-аналитический-слой"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_priv" value="Сквозные блоки Privacy by Design (новые)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1620" height="230" as="geometry"/></mxCell><mxCell id="b_core" value="Домены данных - границы доверия, обмен только по API с patient_id" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1080" height="420" as="geometry"/></mxCell><mxCell id="b_an" value="Аналитический слой (новый)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1160" y="310" width="500" height="420" as="geometry"/></mxCell><mxCell id="b_bo" value="Бэк-офис" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1620" height="190" as="geometry"/></mxCell><mxCell id="idp" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Keycloak: OIDC, MFA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;роли и атрибуты для RBAC/ABAC; федерация с AD&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;API Gateway + PEP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[OAuth2, OPA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;решение по роли, атрибутам и тегам данных; rate limit&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="cons" value="&lt;b&gt;Сервис согласий&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Consent Management]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;версии согласий, отзыв, прекращение обработки, сроки хранения&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;Каталог данных и теги&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[OpenMetadata, Lineage]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;словарь тегов, lineage, выполнение запросов субъектов&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="kms" value="&lt;b&gt;KMS + Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[ключи, секреты]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;шифрование полей, envelope, ротация&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="180" height="100" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Аудит и мониторинг&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[SIEM, UEBA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;аудит доступа к тегированным данным, аномалии, алерты&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="80" width="190" height="100" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;Privacy Gate CI/CD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[линтер контрактов]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;блокирует релиз с [pii:special] в публичном API/логах&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="80" width="170" height="100" as="geometry"/></mxCell><mxCell id="dlp" value="&lt;b&gt;DLP и защита рабочих мест&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[endpoint, VDI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;запрет USB, локальных копий и ПДн во вложениях&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="480" height="60" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;Маскирование логов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Vector/Logstash]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;тегированные поля не попадают в логи в открытом виде&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="480" height="60" as="geometry"/></mxCell><mxCell id="ret" value="&lt;b&gt;Политика хранения и уничтожения&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[retention jobs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;удаление по сроку и по запросу субъекта через lineage&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="195" width="580" height="60" as="geometry"/></mxCell><mxCell id="portal" value="&lt;b&gt;Портал клиента / моб. приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React / Flutter]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;owner-check: только свои данные&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="300" height="90" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Портал сотрудников&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ресепшен и врач - разные роли&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="300" height="90" as="geometry"/></mxCell><mxCell id="ident" value="&lt;b&gt;Домен Identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL, шифр. полей]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;контакты, договор [pii:direct, pii:contact]; выдаёт patient_id&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="300" height="100" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;Домен Расписание и уведомления&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;слоты, записи по patient_id; уведомления без medical&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="300" height="100" as="geometry"/></mxCell><mxCell id="clin" value="&lt;b&gt;Домен Clinical&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL + S3, шифр. полей]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;медкарта, заключения, анализы [pii:special, medical]&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="480" width="300" height="100" as="geometry"/></mxCell><mxCell id="bill" value="&lt;b&gt;Домен Billing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;счета, токены платежей [financial]&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="300" height="90" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;обращения, маркетинг по согласию; без medical&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="300" height="90" as="geometry"/></mxCell><mxCell id="labint" value="&lt;b&gt;Lab Integration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[адаптер, mTLS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;lab_pseudonym вместо Ф. И. О.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="300" height="90" as="geometry"/></mxCell><mxCell id="etl" value="&lt;b&gt;ETL с обезличиванием&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Airflow]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;псевдонимизация, обобщение дат/адресов, k-анонимность; правила из тегов&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="460" height="100" as="geometry"/></mxCell><mxCell id="lake" value="&lt;b&gt;Озеро данных&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[S3 (SSE-KMS) + ClickHouse]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;зоны raw (закрыта, retention) / anonymized / marts; RLS&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="480" width="460" height="100" as="geometry"/></mxCell><mxCell id="bi" value="&lt;b&gt;BI / ML / LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Superset, Jupyter, ML-платформа]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;только anonymized и marts; роли; без доступа к raw&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="610" width="460" height="90" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1С:Бухгалтерия и 1С:Торговля&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[клиент-сервер, PostgreSQL, TDE]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;роли, журнал регистрации -&amp;gt; SIEM; HTTP-сервисы вместо OLE&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="440" height="100" as="geometry"/></mxCell><mxCell id="kkm" value="&lt;b&gt;ККМ + ОФД&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[TLS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;подписанные фискальные документы&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="820" width="300" height="100" as="geometry"/></mxCell><mxCell id="ad" value="&lt;b&gt;AD / почта / файлы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[отдельные VLAN и хосты]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;без медицинских данных; DLP&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="820" width="340" height="100" as="geometry"/></mxCell><mxCell id="bk" value="&lt;b&gt;Резервные копии&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[шифрование, в РФ]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ключи в KMS, тест восстановления&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="820" width="380" height="100" as="geometry"/></mxCell><mxCell id="e0" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="staff" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="токен" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="idp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="согласие?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="RBAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor