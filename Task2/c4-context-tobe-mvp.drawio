<mxfile host="app.diagrams.net" type="device"><diagram name="C4 Context - Медикаменте To-Be MVP" id="C4-Context---Медикаменте-To-Be-MVP"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;самозапись, свои данные, согласия&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Ресепшен&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;расписание, контакты, договоры&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="200" height="110" as="geometry"/></mxCell><mxCell id="doc" value="&lt;b&gt;Специалист-медик&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;медкарта своих пациентов&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="200" height="110" as="geometry"/></mxCell><mxCell id="it" value="&lt;b&gt;Технический директор, ИБ, бизнес-аналитик&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;политики, аудит, витрины&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="220" height="130" as="geometry"/></mxCell><mxCell id="back" value="&lt;b&gt;Кассир, бухгалтер, склад&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;платежи, учёт, ТМЦ&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="640" width="220" height="110" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Платформа «Медикаменте»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Software System, K8s в ЦОД (152-ФЗ)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;порталы, домены Identity / Расписание / Clinical / Billing / CRM, Lab Integration; сквозные блоки Privacy by Design: IdP, API Gateway + PEP, согласия, каталог и теги данных, KMS, аудит/SIEM, Privacy Gate CI/CD; аналитический слой с обезличиванием&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="460" height="220" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Лаборатория анализов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешняя система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;партнёрский API, mTLS, lab_pseudonym&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="220" height="90" as="geometry"/></mxCell><mxCell id="psp" value="&lt;b&gt;Платёжный провайдер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PCI DSS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;hosted page, токенизация, PAN не попадает в систему&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="220" height="90" as="geometry"/></mxCell><mxCell id="sms" value="&lt;b&gt;SMS / push / телефония&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешние сервисы]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;уведомления без медицинских данных&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="40" width="200" height="90" as="geometry"/></mxCell><mxCell id="one" value="&lt;b&gt;1С:Бухгалтерия, 1С:Торговля, ККМ/ОФД&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[бэк-офис, клиент-серверный режим]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;агрегаты без ПДн пациентов; роли, журнал -&amp;gt; SIEM&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="300" height="100" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;ФНС, СФР, ОФД&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[внешние системы]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ЭДО, КЭП&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="200" height="80" as="geometry"/></mxCell><mxCell id="ad" value="&lt;b&gt;AD / почта / файловый сервер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[корпоративная ИТ]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;без медицинских данных, DLP, отдельный сегмент&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="780" width="300" height="80" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS, OIDC + MFA: запись, свои данные, согласия" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pat" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS, OIDC + MFA: RBAC «ресепшен»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTPS, OIDC + MFA: ABAC «врач + запись»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doc" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="политики OPA, теги, аудит, витрины" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="it" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="роли 1С, MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="back" target="one"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="заказ по lab_pseudonym, результаты (webhook, подпись)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sys" target="lab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="TLS, токен платежа" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sys" target="psp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="И. О., время приёма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sys" target="sms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="агрегаты платежей без ПДн, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sys" target="one"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="ЭДО, фискальные документы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#333333;fontSize=9;endArrow=blockThin;endFill=1;labelBackgroundColor=#ff